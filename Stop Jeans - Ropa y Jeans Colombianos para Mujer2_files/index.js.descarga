  text-transform: none;
  font: var(--forms-heading-font);
  line-height: 26px;
  color: var(--heading-text-color);
  margin: 0 0 5px;
}

legend {
  padding: 0;
}

fieldset {
  margin: 0;
}

/* MX preview with image */
@media screen and (min-width: 893px) {
