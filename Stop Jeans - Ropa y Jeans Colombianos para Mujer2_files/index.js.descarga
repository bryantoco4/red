  .isPreview.isPreview--withImage p._textBody_2aowh_10,
  .isPreview.isPreview--withImage ._textBody_2aowh_10 {
    font-size: calc(var(--forms-base-font-size) / var(--preview-scale));
    line-height: calc(20px / var(--preview-scale));
  }
}

