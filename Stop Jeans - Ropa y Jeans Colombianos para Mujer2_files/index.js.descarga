  button._teaserContainer_trejf_5 {
    margin: 0 var(--spacing-size);
    padding: 16px;
    gap: 8px;

    /* 92px - width of inbox widget, 48px - additional space to allow for margins */
    max-width: calc(100vw - 92px - 48px);
