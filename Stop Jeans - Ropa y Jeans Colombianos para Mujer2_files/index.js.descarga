  width: 100%;
}

._formFileInputField_k0hif_5 {
  background-color: var(--form-background-color);
  color: var(--form-text-color);
  border: 1px dashed rgb(204, 204, 204);
  border-radius: var(--form-field-border-radius);
  display: flex;
  cursor: pointer;
  justify-content: center;
  align-items: center;
  margin-top: 8px;
  position: relative;
  width: 100%;
}

._formFileInputLabel_k0hif_19 {
  cursor: pointer;
  inset: 0;
  position: absolute;
  z-index: 0;
}

._formFileInputContent_k0hif_26 {
  align-items: center;
  display: flex;
  justify-content: center;
  padding: 26px 0;
  pointer-events: none;
  position: relative;
  width: 100%;
  z-index: 1;
}

._formFileInputButton_k0hif_37 {
  background-color: rgb(241, 241, 241);
  font: var(--forms-body-font);
  font-weight: 400;
  font-size: 12px;
  color: rgb(97, 97, 97);
  line-height: 20px;
  padding: 6px;
  border-radius: var(--form-field-border-radius);
}

._formFileInputNativeInput_k0hif_48 {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

._formFileInputField_k0hif_5:has(:focus-visible) {
  box-shadow: inset 0 0 0 2px var(--forms-accent-color);
}

._formFileInputButton_k0hif_37:hover {
  background-color: rgb(222, 222, 222);
  color: rgb(97, 97, 97);
}

._formFileInputFileName_k0hif_69 {
