  margin: 5px 0 0;
  line-height: 26px;
}

._formBannerContainer_z5ku3_1 ._formBannerHeading_z5ku3_9 {
  --close-button-size: 12px;
  display: grid;
  grid-template-columns: minmax(20px, auto) auto;
  justify-content: var(--container-text-alignment);

