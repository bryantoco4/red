  max-width: var(--inline-container-max-width);
  width: 100%;
  min-height: var(--inline-container-min-height);
}

/* Overlay */
._overlay_29s4r_104 {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

